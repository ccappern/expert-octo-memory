# macOS
.DS_Store

# Supabase CLI-tilstand (inneholder prosjekt- og tilkoblingsdetaljer)
supabase/.temp/

# Tilkoblingsstreng til databasen, se supabase/kjor.sh
.nordlys-db

# API-nøkler (Resend m.m.). Settes i Supabase med `supabase secrets set`.
.env
.env.*

# ---------------------------------------------------------------------------
# Hypotesetekstene publiseres IKKE.
#
# Dette repoet er offentlig, fordi GitHub Pages krever det. Migrasjonene under
# inneholder til sammen rundt 64 setninger som beskriver hvilke deler av
# Nordlys som er uverifisert: at TLP-håndheving ikke er testet, at det ikke
# finnes en juridisk enhet, at NVE ikke er kontaktet, at det ikke finnes en
# plan B dersom KraftCERT takker nei. Samlet er det et kart over svakhetene i
# et kraftsektorinitiativ, og det er ikke klarert for offentliggjøring.
#
# Innholdet ligger i Supabase, bak workshopkoden. Filene ligger lokalt hos den
# som kjører migrasjonene. Repoet inneholder verktøyet, ikke dataene.
#
# Er dette feil vurdering, fjern linjene under og kjør:
#   git add -f supabase/migrations/000{3,5,6,8}*.sql
# Men gjør det før første push – etter det ligger teksten i historikken.
# ---------------------------------------------------------------------------
supabase/migrations/0003_seed_forprosjekt.sql
supabase/migrations/0005_rydd_typer.sql
supabase/migrations/0006_tilpasningsevne.sql
supabase/migrations/0008_fire_typer.sql
supabase/migrations/0013_eierskap_og_to_nye.sql

# ---------------------------------------------------------------------------
# Personopplysninger publiseres IKKE.
#
# Av samme grunn som over: repoet er offentlig. Invitasjonslista inneholder
# navn og e-postadresse til 21 navngitte personer i sju virksomheter. Det er
# personopplysninger, og en ferdig adresseliste for den som vil utgi seg for
# å være en av dem overfor de andre.
#
# Lista ligger i Supabase. Filen ligger lokalt hos den som kjører migrasjonen.
# ---------------------------------------------------------------------------
supabase/migrations/0016_invitasjonsliste.sql

# Arbeidsfiler med hypotesetekst hentet ut av Confluence eller registeret.
# Samme begrunnelse som over: innholdet er ikke klarert for offentliggjøring.
*_tmp.md
fra_confluence*.md
